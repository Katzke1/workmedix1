<%- include('../partials/head') %>
<body>
<div class="app-body">
<%- include('../partials/admin-sidebar') %>
<main class="app-main">
  <div class="app-topbar">
    <div class="app-topbar-title">
      <h2><%= emp.first_name %> <%= emp.last_name %></h2>
      <p>Patient record<% if (emp.job_title) { %> · <%= emp.job_title %><% } %></p>
    </div>
    <div class="topbar-actions">
      <a href="/admin/patients" style="font-size:.85rem;color:var(--mid-grey);">← Back to patients</a>
    </div>
  </div>

  <div class="app-content">
    <% const fmtDate = iso => iso ? new Date(iso).toLocaleDateString('en-ZA', { day: '2-digit', month: 'short', year: 'numeric' }) : '—'; %>

    <div class="card" style="margin-bottom:1.5rem;">
      <div class="card-body" style="display:flex;gap:1.5rem;flex-wrap:wrap;align-items:center;">
        <div style="width:60px;height:60px;background:var(--primary);border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:1.5rem;font-weight:800;color:white;flex-shrink:0;">
          <%= (emp.first_name || '?').charAt(0).toUpperCase() %>
        </div>
        <div style="flex:1;min-width:220px;">
          <h3 style="color:var(--primary);margin-bottom:.4rem;"><%= emp.first_name %> <%= emp.last_name %></h3>
          <div style="display:flex;gap:1.5rem;flex-wrap:wrap;font-size:.9rem;color:var(--text-light);">
            <span><strong>ID / Passport:</strong> <%= emp.id_number || emp.passport_number || '—' %></span>
            <span><strong>Sex:</strong> <%= emp.gender || '—' %></span>
            <span><strong>DOB:</strong> <%= emp.date_of_birth || '—' %></span>
            <span><strong>Latest site:</strong> <%= emp.site %></span>
          </div>
        </div>
      </div>
    </div>

    <div class="card">
      <div class="card-header"><h3>Scan history (<%= scans.length %>)</h3></div>
      <div class="table-wrap">
        <table>
          <thead>
            <tr><th>Date</th><th>Site</th><th>Service</th><th>Status</th></tr>
          </thead>
          <tbody>
            <% if (scans.length === 0) { %>
              <tr><td class="table-empty" colspan="4">No scans on record.</td></tr>
            <% } else { scans.forEach(s => { %>
              <tr>
                <td style="white-space:nowrap;"><%= fmtDate(s.scan_date) %></td>
                <td><%= s.site %></td>
                <td style="font-size:.88rem;"><%= s.service_type || '—' %></td>
                <td><span class="badge badge-<%= s.attendance_status === 'attended' ? 'confirmed' : 'pending' %>"><%= (s.attendance_status || '').replace(/_/g, ' ') || '—' %></span></td>
              </tr>
            <% }) } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</main>
</div>
<script src="/js/main.js?v=<%= locals.assetVersion %>"></script>
</body>
</html>
